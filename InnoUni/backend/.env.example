# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Use a long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=oqiv_platform

# Contact form (Gmail app password: Google Account > Security > 2-Step Verification > App passwords)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASS=
