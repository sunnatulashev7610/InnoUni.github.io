# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# REQUIRED (min 16 characters). The server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=oqiv_platform
# Cloud MySQL only:
# DB_PORT=4000
# DB_SSL=true

# Browser origins allowed to call the API (comma-separated).
# Add your real site, e.g. https://innouni.github.io
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to 1 when running behind a reverse proxy (Render, Heroku, nginx)
# TRUST_PROXY=1

# Contact form (Gmail app password: Google Account > Security > 2-Step Verification > App passwords)
# Without EMAIL_USER and EMAIL_PASS the contact form answers 503.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASS=
# Where contact messages are delivered (defaults to EMAIL_USER)
# CONTACT_TO=

# Public contact details shown by the Telegram bot (defaults are the Gather Edu ones)
# CONTACT_EMAIL_PUBLIC=info.gatheredu@gmail.com
# CONTACT_PHONE_PUBLIC=+998 90 472 61 35

# Telegram bot: create it with @BotFather (/newbot) and paste the token here.
TELEGRAM_BOT_TOKEN=
# Any random string of letters, digits, _ or - (Telegram sends it back on every webhook call)
TELEGRAM_WEBHOOK_SECRET=
# Team chat that receives site-form messages and bot questions. Send /id to the bot to get a chat id.
TELEGRAM_ADMIN_CHAT_ID=
# Public API address for the webhook (Render sets RENDER_EXTERNAL_URL itself)
# PUBLIC_URL=https://gatheredu-io.onrender.com

# AI tutor. Without a key the tutor gives clearly labelled demo answers.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# Questions per user per day (default 10)
# AI_DAILY_LIMIT=10

# E-mail to users (verification, password reset).
# Render's free plan blocks SMTP, so use an HTTPS mail API: create a free Brevo account, verify a sender, then set:
# BREVO_API_KEY=
# MAIL_FROM=noreply@your-domain-or-verified-sender
# (Hosts that allow SMTP can use EMAIL_USER / EMAIL_PASS above instead.)
# Public address of the site, used in the links inside the mails:
# FRONTEND_URL=https://sunnatulashev7610.github.io/InnoUni.github.io/InnoUni
# Teachers must confirm their e-mail before creating courses or answering orders:
# REQUIRE_EMAIL_VERIFICATION=true

# AI course creator: courses per user per day (default 3)
# AI_COURSE_DAILY_LIMIT=3

# AI material creator: materials per user per day (default 5)
# AI_MATERIAL_DAILY_LIMIT=5
